;/*++
;
; (C) 2026 Electronic Team, Inc. All rights reserved.
;
;Module Name:
;
;    evsbc9.inf
;
;Abstract:
;    INF file for installing virtual serial bus enumerator driver
;
;--*/
[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%Electronic%
DriverVer=04/22/2026,10.6.960.0
CatalogFile=evsbc9.cat
PnpLockdown=1

[DestinationDirs]
Drivers_Dir = 12

[SourceDisksNames]
1 = %DiskId1%,,,""

[SourceDisksFiles]
evsbc9.sys  = 1,,
;evserial.sys = 1,,

;*****************************************
; VSBus  Install Section
;*****************************************

[Manufacturer]
%Electronic%=Electronic, NTx86, NTia64, NTamd64, NTarm64, NTarm

[Electronic.NTx86]
%VSBus.DeviceDesc%=VSBus_Device, VSBC9

[Electronic.NTamd64]
%VSBus.DeviceDesc%=VSBus_Device, VSBC9

[Electronic.NTia64]
%VSBus.DeviceDesc%=VSBus_Device, VSBC9

[Electronic.NTarm64]
%VSBus.DeviceDesc%=VSBus_Device, VSBC9

[Electronic.NTarm]
%VSBus.DeviceDesc%=VSBus_Device, VSBC9


[VSBus_Device.NT]
CopyFiles=Drivers_Dir

[Drivers_Dir]
evsbc9.sys
;evserial.sys

;-------------- Service installation
[VSBus_Device.NT.Services]
AddService = VSBC9,%SPSVCINST_ASSOCSERVICE%, VSBus_Service_Inst

; -------------- vsbus driver install sections
[VSBus_Service_Inst]
DisplayName    = %VSBus.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START 
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\evsbc9.sys
LoadOrderGroup = Extended Base


[Strings]
SPSVCINST_ASSOCSERVICE= 0x00000002
Electronic = "Electronic Team"
DiskId1 = "Virtual Serial Bus Installation Disk #1"
VSBus.DeviceDesc = "Virtual Serial Bus Enumerator 10 (Electronic Team)"
VSBus.SVCDESC = "Virtual Serial Bus Enumerator 10 (Electronic Team)"
